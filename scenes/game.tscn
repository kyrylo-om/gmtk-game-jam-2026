"times": PackedFloat32Array(2, 7.4, 12, 16, 22.033333),
"transitions": PackedFloat32Array(1, 1, 1, 1, 1),
"values": [{
"args": ["Guilt blinded me like fire."],
"method": &"show_text"
}, {
"args": ["It consumed me whole, and I gave in."],
"method": &"show_text"
}, {
"args": ["Just like on that day, when I lost her."],
"method": &"show_text"
}, {
"args": ["When I lost everything."],
"method": &"show_text"
}, {
"args": ["Maybe I should've listened."],
"method": &"show_text"
}]
}
